# lu4launcher.ini  —  copie para "lu4launcher.ini" (ao lado do .exe) e ajuste.
# Formato: chave=valor, uma por linha. '#' ou ';' = comentario.
# Toda chave e OPCIONAL: sem o .ini, os defaults abaixo valem.

# --- caminhos (relativos a pasta do launcher, ou absolutos) ---
# Executavel do cliente LU4:
GameExe=lu4\binaries\win64\lu4-win64-shipping.exe
# DLL do hook (normalmente ao lado do launcher):
HookDll=lu4authhook.dll
# Argumentos passados ao cliente:
GameArgs=LU4 -USEALLAVAILABLECORES

# --- credenciais (OPCIONAL) ---
# Se preenchidas, o launcher de console nao pergunta (util so pra teste local).
# DEIXE EM BRANCO/REMOVA para digitar no launcher. NUNCA comite este arquivo.
Login=
Pass=

# --- rede ---
# LocalDev=1  -> monta loopback + portproxy (dev na mesma maquina; precisa Admin).
# LocalDev=0  -> conecta direto no IP real do servidor (producao).
LocalDev=1
# IP que o cliente conecta (no dev, um alias de loopback):
LoginIp=185.29.255.102
# Porta que o cliente usa:
LoginPort=2108
# Porta do seu AuthServer (destino do portproxy no dev):
AuthPort=2107
